{
  "name": "udo-panel",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": true },
  "workers_dev": true,
  "preview_urls": false
}
